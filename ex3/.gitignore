# This experiment deliberately retains result evidence even though the parent
# repository ignores directories named results.
!/results/
!/results/**

# Local history, publication staging and reproducible caches
/.local/
/tmp/
/.venv/
/venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
Thumbs.db
*.log
*.reference/
/prediction_reproduced.csv

# Regenerate processed text with scripts/preprocessing/preprocess.py
/data-processed/*
!/data-processed/README.md

# Publish only the selected prediction model; retain all other runs locally
/models/*
!/models/README.md
!/models/linear_svm_split_B_raw_C1.0/
